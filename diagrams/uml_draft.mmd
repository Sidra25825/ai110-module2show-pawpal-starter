classDiagram
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +int age
        +str species
        +list~Task~ tasks
        +add_task(task: Task) None
    }

    class Task {
        +str type
        +str time
        +str title
        +str details
        +str frequency
        +str pet_name
        +date due_date
        +bool completed
        +mark_complete() None
    }

    class Scheduler {
        +Owner owner
        +get_todays_schedule() list~Task~
    }

    Owner "1" --> "0..*" Pet : has
    Pet "1" --> "0..*" Task : has
    Scheduler ..> Owner : uses
